#!/usr/bin/env python3
import requests
import sys
from bs4 import BeautifulSoup


args = " ".join(sys.argv[1:])
if not args:
    sys.exit(1)

# Expect: Artist - Song
if "-" not in args:
    sys.exit(1)

artist, title = map(str.strip, args.split("-", 1))

url = f"https://api.lyrics.ovh/v1/{artist}/{title}"
resp = requests.get(url)

if resp.status_code != 200:
    sys.exit(1)

data = resp.json()
lyrics = data.get("lyrics")

if not lyrics:
    sys.exit(1)

print(f"{artist} - {title}", end="\n\n")
print(lyrics)
sys.exit(0)